# Sivva Environment Variables
NODE_ENV=development

# Database (PostgreSQL via Docker compose)
DATABASE_URL=postgresql://sivva:sivva_dev_password@localhost:5432/sivva

# Better Auth
BETTER_AUTH_SECRET=dev_secret_sivva_study_companion_32chars_min
BETTER_AUTH_URL=http://localhost:3000
# Public app origin used by the auth client during SSR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (for Better Auth)
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret

# Gemini API
GEMINI_API_KEY=placeholder_gemini_api_key
# Optional: explicit stable model ID, validated server-side.
GEMINI_MODEL=gemini-3.5-flash-lite

# Phase 2: YouTube Data API v3 (optional; leave commented out if not configured)
# YOUTUBE_API_KEY=your_youtube_data_api_key
# OpenAlex paper search works without a key; add one for a higher quota.
# OPENALEX_API_KEY=your_openalex_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=placeholder_cloudinary_cloud_name
CLOUDINARY_API_KEY=placeholder_cloudinary_api_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret
