# Sivva Environment Variables
NODE_ENV=development

# Database (PostgreSQL via Docker compose)
DATABASE_URL=postgresql://sivva:sivva_dev_password@localhost:5432/sivva

# Better Auth
BETTER_AUTH_SECRET=dev_secret_sivva_study_companion_32chars_min
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (for Better Auth)
GOOGLE_CLIENT_ID=placeholder_google_client_id
GOOGLE_CLIENT_SECRET=placeholder_google_client_secret

# Gemini API
GEMINI_API_KEY=placeholder_gemini_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=placeholder_cloudinary_cloud_name
